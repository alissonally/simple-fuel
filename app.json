{
  "expo": {
    "name": "Controle de Combustível",
    "slug": "controle-combustivel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.mobimark.controlecombustivel"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.mobimark.controlecombustivel"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita o uso do microfone para ditar abastecimentos.",
          "speechRecognitionPermission": "Permita o reconhecimento de voz para transformar o que você fala em um abastecimento."
        }
      ]
    ],
    "scheme": "controlecombustivel",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "170ebc67-11b0-4add-8f2b-a17aab565e98"
      }
    }
  }
}
